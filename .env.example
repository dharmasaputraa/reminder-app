# Required — channel config encryption key (AES-256-GCM). Minimum 16 characters.
APP_SECRET=replace-with-a-long-random-string

# Auth — filled in from Cloudflare Zero Trust (see README §Cloudflare Access)
AUTH_MODE=cfaccess
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=xxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAILS=email@example.com

# General
# TZ = container process timezone (logs). Schedule timezone & send time are configured in the Settings UI.
TZ=Asia/Makassar
DATA_DIR=/data
ADDR=:8080

# App port published to the host (cloudflared on the host -> http://localhost:<APP_PORT>)
APP_PORT=8080

# Only for the cloudflared profile (ignore if cloudflared runs directly on the host)
TUNNEL_TOKEN=

# Only for the litestream profile (can be left empty if you don't use litestream).
# For R2, ENDPOINT is required; for S3 it can be left empty (uses the default AWS endpoint).
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_ENDPOINT=

# Dev only (AUTH_MODE=dev): with both values set, the server seeds a Telegram
# notification channel named "Telegram (dev)" for the first ADMIN_EMAILS entry
# at startup. Idempotent; leave empty to disable.
DEV_SEED_TELEGRAM_BOT_TOKEN=
DEV_SEED_TELEGRAM_CHAT_ID=
